# Энэ файлыг хуулж .env нэртэй болгоод доорхыг бөглөнө.
# .env файлыг хэзээ ч github-д бүү тавь (нийтэд ил болно).

ANTHROPIC_API_KEY=энд-өөрийн-api-key-ээ-тавина

# Заавал биш. Default нь claude-sonnet-4-6 (Claude Sonnet 4.6 — бодит модель, $3/$15 per 1M token).
# Хямд хувилбарууд: claude-sonnet-5-5 ($2/$10), claude-haiku-5-5 ($0.10/$0.50)
MYSTYLE_MODEL=claude-sonnet-4-6

# Өгөгдлийн сан. Production (Vercel) дээр заавал. Neon / Supabase / Vercel Postgres-ийн connection string.
# Хоосон бол локал data/db.json файл ашиглана (зөвхөн хөгжүүлэлтэд).
DATABASE_URL=

# Session cookie-д гарын үсэг зурах нууц. Production дээр заавал. Үүсгэх: openssl rand -hex 32
SESSION_SECRET=

# /api/admin/stats-ийг харах нууц token (Authorization: Bearer ...)
ADMIN_TOKEN=

# Үнэгүй хязгаар (заавал биш — доорх нь default утгууд)
# Нэвтрээгүй: IP тутамд өдөрт
FREE_ANON_PER_DAY=1
# Бүртгэлтэй: сард
FREE_USER_PER_MONTH=5
# Нэг IP-аас өдөрт (олон account нээхээс хамгаална)
IP_PER_DAY=10
# Бүх хэрэглэгч нийлээд өдөрт — зардлын дээд хязгаар
GLOBAL_PER_DAY=300
# Нэвтрэх оролдлого IP тутамд цагт
AUTH_PER_HOUR=20

# Proxy-ийн ард (Render, Railway) ажиллуулбал 1 болго — бодит IP-г авна. Vercel дээр автомат.
TRUST_PROXY=

# Заавал биш. Default 3000.
PORT=3000
